# ──────────────────────────────────────────────────────────────────────────────
# Shopify Storefront API
# ──────────────────────────────────────────────────────────────────────────────

# Your Shopify store domain (e.g. my-store.myshopify.com)
PUBLIC_SHOPIFY_STORE_DOMAIN=

# Shopify Storefront API access token (public scoped)
PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Shopify Admin API access token (server-side only — never expose to client)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify API version (e.g. 2024-04)
PUBLIC_SHOPIFY_API_VERSION=2024-04

# ──────────────────────────────────────────────────────────────────────────────
# Mock mode
# Set to "true" to bypass Shopify entirely and use local fixture data.
# Useful for development without Shopify credentials.
# ──────────────────────────────────────────────────────────────────────────────
SHOPIFY_MOCK=true

# ──────────────────────────────────────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────────────────────────────────────

# Secret used to sign session cookies — generate with: openssl rand -base64 32
SESSION_SECRET=
