---
import type { ProductVariantResult } from '~/service/schemas/product-schema.ts';

interface Props {
  variant: ProductVariantResult;
}
const { variant } = Astro.props;
---

<button
  class="bg-cw_orange m-1 cursor-pointer p-2 px-4 align-middle text-white transition-colors hover:bg-cw_dark_orange"
  data-variant-id={variant.id}
  data-product-handle={variant.product.handle}
  data-product-title={variant.product.title}
  data-variant-title={variant.title}
  data-price-amount={String(variant.price.amount)}
  data-price-currency={variant.price.currencyCode}
  data-image-url={variant.image?.url ?? ''}
  onclick="addToCart(event)"
>
  Add to Cart
</button>
