---
import Icon from '~/components/elements/Icon.astro';
import Button from '~/components/elements/Button.astro';

const { class: className, ...props } = Astro.props;
const tailwind = "font-['Commerce'] text-xl float-right rounded-none";
---

<a
  x-data
  href="/users/cart"
  class:list={[tailwind, className, 'd-btn d-btn-primary rounded-none']}
>
  <span>Cart</span>
  <span
    x-show="$store.cart?.qty > 0"
    x-text="`(${$store.cart?.qty ?? 0})`"
    class="ml-1"
  ></span>
</a>
