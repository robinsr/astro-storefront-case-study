---
import '~/styles/global.css';

import { ClientRouter } from "astro:transitions";

export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = "A basic HTML page", lang = "en" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <ClientRouter />
  </head>

  <body>
    <header>
      <div class="container">
        <h1>{title}</h1>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer>
      <div class="container">
        <p>&copy; 2024 Your Company. All rights reserved.</p>
      </div>
    </footer>

    <script>
      import Alpine from 'alpinejs';
      document.addEventListener('astro:page-load',() => {
        window.Alpine = Alpine;
        Alpine.start();
      });
    </script>
  </body>
</html>
