---
import { ViewTransitions } from 'astro:transitions';
import BaseHead from '~/components/page/BaseHead.astro';
import Header from '~/components/page/Header.astro';
import Footer from '~/components/page/Footer.astro';
import { SITE_DESCRIPTION, PAGE_TRANSITIONS } from '~/consts';
import { LIGHT_THEME } from '~/consts.themes.ts';
import { getAppLocals } from '~/util/astro';

interface Props {
  title?: string;
  description?: string;
  mainClass?: string;
  bodyClass?: string;
}

const { title = '', description = SITE_DESCRIPTION, bodyClass = '', mainClass = '' } = Astro.props;

const { theme = LIGHT_THEME } = getAppLocals(Astro);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <BaseHead title={title} description={description}>
      <slot name="head-scripts" slot="head" />
    </BaseHead>
    {PAGE_TRANSITIONS && <ViewTransitions />}
  </head>

  <body class:list={[bodyClass]}>
    <script is:inline>
      const theme = localStorage.getItem('user_theme');
      if (theme) {
        try {
          const { value } = JSON.parse(theme);
          if (value) document.documentElement.dataset.theme = value;
        } catch {}
      }
    </script>

    <slot name="before-nav" />
    <Header />
    <slot name="after-nav" />

    <main class:list={[mainClass, 'relative md:mt-4']}>
      <slot name="before-content" />
      <slot />
      <slot name="after-content" />
    </main>

    <slot name="before-footer" />
    <Footer />
    <slot name="after-footer" />

    <script>
      import { onEveryPageLoad } from '~/scripts/astro.transitions';
      import Alpine from 'alpinejs';
      import '~/scripts/cart';

      onEveryPageLoad(() => {
        window.Alpine = Alpine;
        Alpine.start();
      });
    </script>
    <slot name="end-scripts" />
  </body>
</html>
